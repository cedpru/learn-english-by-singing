{
  "name": "sing-along",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Écoute la radio (ou n'importe quelle source), reconnaît le morceau et affiche les paroles synchronisées en anglais avec la traduction française.",
  "scripts": {
    "dev": "concurrently -n server,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "nest start --watch",
    "dev:web": "vite",
    "start": "node server/dist/main.js",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node server/dist/main.js",
    "build": "tsc --noEmit && vite build",
    "build:server": "nest build",
    "typecheck": "tsc --noEmit",
    "typecheck:server": "tsc -p server/tsconfig.json --noEmit",
    "test": "jest --config server/jest.config.js",
    "test:unit": "jest --config server/jest.config.js --testPathPattern=__tests__",
    "test:e2e": "jest --config server/test/jest-e2e.json --runInBand",
    "test:cov": "jest --config server/jest.config.js --coverage",
    "test:watch": "jest --config server/jest.config.js --watch",
    "desktop": "npm run build:server && cd desktop && flutter run -d windows",
    "desktop:build": "npm run build:server && cd desktop && flutter build windows --release"
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@huggingface/transformers": "^4.3.1",
    "@nestjs/axios": "^3.0.0",
    "@nestjs/cache-manager": "^2.1.0",
    "@nestjs/common": "^10.3.0",
    "@nestjs/config": "^3.1.1",
    "@nestjs/core": "^10.3.0",
    "@nestjs/platform-express": "^10.3.0",
    "@nestjs/platform-socket.io": "^10.3.0",
    "@nestjs/swagger": "^7.1.0",
    "@nestjs/terminus": "^10.3.0",
    "@nestjs/websockets": "^10.3.0",
    "cache-manager": "^5.2.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "helmet": "^7.1.0",
    "node-shazam": "^1.2.7",
    "rate-limiter-flexible": "^5.0.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "reflect-metadata": "^0.2.1",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.3.0",
    "@nestjs/schematics": "^10.1.0",
    "@nestjs/testing": "^10.3.0",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.23",
    "@types/jest": "^29.5.11",
    "@types/multer": "^1.4.12",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@types/supertest": "^6.0.2",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.0",
    "tsx": "^4.20.4",
    "typescript": "^5.9.2",
    "vite": "^7.1.2"
  }
}
